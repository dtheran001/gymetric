{
  "expo": {
    "name": "gymetric",
    "slug": "gymetric",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/gymetric-icon-dark.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/gymetric-splash-dark-v2.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0F14"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.danyk.gymetric",
      "adaptiveIcon": {
        "foregroundImage": "./assets/gymetric-icon-dark.png",
        "backgroundColor": "#0B0F14"
      },
      "edgeToEdgeEnabled": false,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/gymetric-icon-dark.png"
    },
    "plugins": [
      "expo-sqlite",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gymetric necesita acceso a tus fotos para guardar fotos de progreso corporal."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Gymetric necesita acceso a tu galería para guardar fotos de progreso.",
          "savePhotosPermission": "Gymetric necesita permiso para guardar fotos en tu galería.",
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-navigation-bar",
        {
          "backgroundColor": "#0B0F14",
          "borderColor": "#0B0F14",
          "barStyle": "light",
          "position": "relative"
        }
      ],
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "25fcbd2b-05eb-49c8-a33d-092267bc9774"
      },
      "expo-navigation-bar": {
        "backgroundColor": "#0B0F14",
        "borderColor": "#0B0F14",
        "barStyle": "light",
        "position": "relative"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/25fcbd2b-05eb-49c8-a33d-092267bc9774"
    }
  }
}
